{
    "name": "grails-extension-vscode",
    "displayName": "Grails Support For VS Code",
    "description": "Grails language support for VS Code with completion, navigation, project model, GSP support and CLI integration",
    "version": "0.7.0",
    "publisher": "JohanMixtegaCisneros",
    "license": "Apache-2.0",
    "homepage": "https://github.com/Johan070119/Grails-VsCode-Extension#readme",
    "bugs": {
        "url": "https://github.com/Johan070119/Grails-VsCode-Extension/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Johan070119/Grails-VsCode-Extension"
    },
    "engines": {
        "vscode": "^1.82.0"
    },
    "categories": [
        "Programming Languages",
        "Other"
    ],
    "galleryBanner": {
        "color": "#2f6f4e",
        "theme": "dark"
    },
    "pricing": "Free",
    "extensionKind": [
        "workspace"
    ],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": "limited",
            "description": "Language features remain available, but Grails, Gradle and JVM semantic execution are disabled."
        },
        "virtualWorkspaces": {
            "supported": false,
            "description": "A local filesystem is required to index and run Grails projects."
        }
    },
    "keywords": [
        "grails",
        "groovy",
        "gsp",
        "java",
        "spring",
        "mvc",
        "web framework",
        "language server",
        "lsp",
        "autocomplete",
        "navigation",
        "scaffold",
        "domain",
        "controller",
        "service"
    ],
    "activationEvents": [
        "onLanguage:groovy",
        "onLanguage:gsp",
        "workspaceContains:grails-app"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "groovy",
                "extensions": [
                    ".groovy"
                ],
                "aliases": [
                    "Groovy",
                    "Grails"
                ]
            },
            {
                "id": "gsp",
                "extensions": [
                    ".gsp"
                ],
                "aliases": [
                    "GSP",
                    "Groovy Server Pages"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "gsp",
                "scopeName": "text.html.gsp",
                "path": "./syntaxes/gsp.tmLanguage.json",
                "embeddedLanguages": {
                    "meta.embedded.inline.groovy": "groovy",
                    "meta.embedded.block.groovy": "groovy",
                    "source.js.embedded.html": "javascript",
                    "source.css.embedded.html": "css"
                }
            }
        ],
        "configuration": {
            "title": "Grails",
            "properties": {
                "grails.trace.server": {
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "off",
                    "description": "Trace LSP communication"
                },
                "grails.semantic.enabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable the experimental compiler-backed Groovy semantic server"
                },
                "grails.semantic.server.jar": {
                    "type": "string",
                    "default": "",
                    "scope": "machine-overridable",
                    "description": "Optional absolute path overriding the bundled Groovy Language Server JAR"
                },
                "grails.semantic.java.home": {
                    "type": "string",
                    "default": "",
                    "scope": "machine-overridable",
                    "description": "JDK home used to launch the experimental semantic server"
                },
                "grails.semantic.java.maxHeapMb": {
                    "type": "number",
                    "default": 1024,
                    "minimum": 256,
                    "maximum": 8192,
                    "scope": "machine-overridable",
                    "description": "Maximum heap in MB assigned to each semantic JVM server"
                },
                "grails.semantic.startupTimeout": {
                    "type": "number",
                    "default": 30000,
                    "minimum": 5000,
                    "maximum": 120000,
                    "description": "Maximum time in milliseconds for the semantic server to start"
                },
                "grails.semantic.classpath": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "scope": "resource",
                    "description": "Additional JARs or directories for Groovy semantic analysis; relative paths resolve from each project root"
                },
                "grails.semantic.gradle.autoClasspath": {
                    "type": "boolean",
                    "default": true,
                    "description": "Resolve the compiler classpath automatically with the trusted project's Gradle Wrapper"
                },
                "grails.semantic.gradle.timeout": {
                    "type": "number",
                    "default": 120000,
                    "minimum": 10000,
                    "maximum": 600000,
                    "description": "Maximum time in milliseconds for Gradle classpath discovery"
                }
            }
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "grails-explorer",
                    "title": "Grails Project",
                    "icon": "images/grails-icon.svg"
                }
            ]
        },
        "views": {
            "grails-explorer": [
                {
                    "id": "grailsProjectExplorer",
                    "name": "Project Structure"
                }
            ]
        },
        "commands": [
            {
                "command": "grails.runApp",
                "title": "Correr Aplicación",
                "category": "Grails",
                "icon": "$(play)"
            },
            {
                "command": "grails.stopApp",
                "title": "Detener",
                "category": "Grails",
                "icon": "$(debug-stop)"
            },
            {
                "command": "grails.clean",
                "title": "Limpiar",
                "category": "Grails",
                "icon": "$(trash)"
            },
            {
                "command": "grails.compile",
                "title": "Compilar",
                "category": "Grails",
                "icon": "$(tools)"
            },
            {
                "command": "grails.refreshTree",
                "title": "Refrescar",
                "category": "Grails",
                "icon": "$(refresh)"
            },
            {
                "command": "grails.ctx.createController",
                "title": "Nuevo Controller",
                "category": "Grails"
            },
            {
                "command": "grails.ctx.createDomain",
                "title": "Nuevo Domain Class",
                "category": "Grails"
            },
            {
                "command": "grails.ctx.createService",
                "title": "Nuevo Service",
                "category": "Grails"
            },
            {
                "command": "grails.ctx.createView",
                "title": "Nueva Vista (GSP)",
                "category": "Grails"
            },
            {
                "command": "grails.ctx.createTagLib",
                "title": "Nuevo TagLib",
                "category": "Grails"
            },
            {
                "command": "grails.runAppDebug",
                "title": "Correr Aplicación (Debug)",
                "category": "Grails"
            },
            {
                "command": "grails.testApp",
                "title": "Ejecutar Tests",
                "category": "Grails"
            },
            {
                "command": "grails.semantic.restart",
                "title": "Reiniciar Servidor Semántico",
                "category": "Grails"
            },
            {
                "command": "grails.ctx.createFolder",
                "title": "Nueva Carpeta",
                "category": "Grails"
            },
            {
                "command": "grails.ctx.createFile",
                "title": "Nuevo Archivo",
                "category": "Grails"
            },
            {
                "command": "grails.ctx.rename",
                "title": "Renombrar",
                "category": "Grails"
            },
            {
                "command": "grails.ctx.delete",
                "title": "Eliminar",
                "category": "Grails"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "grails.runApp",
                    "when": "view == grailsProjectExplorer",
                    "group": "navigation@1"
                },
                {
                    "command": "grails.stopApp",
                    "when": "view == grailsProjectExplorer",
                    "group": "navigation@2"
                },
                {
                    "command": "grails.clean",
                    "when": "view == grailsProjectExplorer",
                    "group": "navigation@3"
                },
                {
                    "command": "grails.compile",
                    "when": "view == grailsProjectExplorer",
                    "group": "navigation@4"
                },
                {
                    "command": "grails.refreshTree",
                    "when": "view == grailsProjectExplorer",
                    "group": "navigation@5"
                }
            ],
            "commandPalette": [
                {
                    "command": "grails.runApp",
                    "when": "false"
                },
                {
                    "command": "grails.stopApp",
                    "when": "false"
                },
                {
                    "command": "grails.clean",
                    "when": "false"
                },
                {
                    "command": "grails.compile",
                    "when": "false"
                },
                {
                    "command": "grails.refreshTree",
                    "when": "false"
                },
                {
                    "command": "grails.ctx.createController",
                    "when": "false"
                },
                {
                    "command": "grails.ctx.createDomain",
                    "when": "false"
                },
                {
                    "command": "grails.ctx.createService",
                    "when": "false"
                },
                {
                    "command": "grails.ctx.createView",
                    "when": "false"
                },
                {
                    "command": "grails.ctx.createTagLib",
                    "when": "false"
                },
                {
                    "command": "grails.runAppDebug",
                    "when": "workspaceContains:grails-app"
                },
                {
                    "command": "grails.testApp",
                    "when": "workspaceContains:grails-app"
                },
                {
                    "command": "grails.semantic.restart",
                    "when": "workspaceContains:grails-app"
                },
                {
                    "command": "grails.ctx.createFolder",
                    "when": "false"
                },
                {
                    "command": "grails.ctx.createFile",
                    "when": "false"
                },
                {
                    "command": "grails.ctx.rename",
                    "when": "false"
                },
                {
                    "command": "grails.ctx.delete",
                    "when": "false"
                }
            ],
            "view/item/context": [
                {
                    "command": "grails.ctx.createController",
                    "when": "view == grailsProjectExplorer && viewItem == grailsFolder_controllers",
                    "group": "1_create@1"
                },
                {
                    "command": "grails.ctx.createDomain",
                    "when": "view == grailsProjectExplorer && viewItem == grailsFolder_domain",
                    "group": "1_create@1"
                },
                {
                    "command": "grails.ctx.createService",
                    "when": "view == grailsProjectExplorer && viewItem == grailsFolder_services",
                    "group": "1_create@1"
                },
                {
                    "command": "grails.ctx.createView",
                    "when": "view == grailsProjectExplorer && viewItem == grailsFolder_views",
                    "group": "1_create@1"
                },
                {
                    "command": "grails.ctx.createTagLib",
                    "when": "view == grailsProjectExplorer && viewItem == grailsFolder_taglib",
                    "group": "1_create@1"
                },
                {
                    "command": "grails.ctx.createFolder",
                    "when": "view == grailsProjectExplorer && viewItem =~ /^grailsFolder/",
                    "group": "2_generic@1"
                },
                {
                    "command": "grails.ctx.createFile",
                    "when": "view == grailsProjectExplorer && viewItem =~ /^grailsFolder/",
                    "group": "2_generic@2"
                },
                {
                    "command": "grails.ctx.createController",
                    "when": "view == grailsProjectExplorer && viewItem == grailsFolder",
                    "group": "3_grails@1"
                },
                {
                    "command": "grails.ctx.createDomain",
                    "when": "view == grailsProjectExplorer && viewItem == grailsFolder",
                    "group": "3_grails@2"
                },
                {
                    "command": "grails.ctx.createService",
                    "when": "view == grailsProjectExplorer && viewItem == grailsFolder",
                    "group": "3_grails@3"
                },
                {
                    "command": "grails.ctx.createView",
                    "when": "view == grailsProjectExplorer && viewItem == grailsFolder",
                    "group": "3_grails@4"
                },
                {
                    "command": "grails.ctx.rename",
                    "when": "view == grailsProjectExplorer && viewItem =~ /^grailsFolder|^grailsFile/",
                    "group": "9_manage@1"
                },
                {
                    "command": "grails.ctx.delete",
                    "when": "view == grailsProjectExplorer && viewItem =~ /^grailsFolder|^grailsFile/",
                    "group": "9_manage@2"
                }
            ]
        }
    },
    "scripts": {
        "compile": "tsc -p tsconfig.json && npm run compile:server",
        "compile:server": "cd server && tsc -p tsconfig.json",
        "watch": "tsc -p tsconfig.json --watch",
        "watch:server": "cd server && tsc -p tsconfig.json --watch",
        "build": "npm run compile",
        "build:semantic": "node scripts/build-semantic-server.mjs",
        "vscode:prepublish": "npm run build",
        "test": "npm run compile && node --test test/*.test.js server/test/*.test.js",
        "test:e2e": "npm run compile && node test/e2e/run.mjs",
        "test:performance": "npm run compile:server && node scripts/performance-budget.mjs",
        "test:release": "npm run test && npm run test:e2e && npm run test:performance",
        "package:release": "npm run compile && node scripts/package-release.mjs",
        "verify:vsix": "node scripts/verify-vsix.mjs",
        "check": "npm run test"
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.0"
    },
    "devDependencies": {
        "@types/node": "^25.4.0",
        "@types/vscode": "^1.82.0",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^3.9.2",
        "typescript": "^5.9.3"
    },
    "icon": "images/icon.png"
}
